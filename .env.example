# Copy this file to .env and fill in real values. .env itself is gitignored.

# Postgres connection. Matches docker-compose.yml's defaults out of the box —
# only change these if you edit docker-compose.yml too, or point at a
# different Postgres server entirely.
DATABASE_URL=postgresql+psycopg2://notes_user:notes_password@localhost:5432/notes_db

# Used to sign JWTs. Generate a real one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-long-random-value

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
